{
  "app": "domainrings",
  "version": 4,
  "kind": "clean",
  "title": "E-commerce — Clean (advanced)",
  "rings": [
    { "role": "domain", "name": "Entities" },
    { "role": "application", "name": "Use Cases" },
    { "role": "adapters", "name": "Interface Adapters" },
    { "role": "outer", "name": "Frameworks & Drivers" }
  ],
  "sectors": [
    { "id": "sec-ordering-domain", "name": "Ordering", "ringRole": "domain" },
    { "id": "sec-payments-domain", "name": "Payments", "ringRole": "domain" },
    { "id": "sec-shipping-domain", "name": "Shipping", "ringRole": "domain" },
    { "id": "sec-ordering-uc", "name": "Ordering", "ringRole": "application" },
    { "id": "sec-payments-uc", "name": "Payments", "ringRole": "application" },
    { "id": "sec-shipping-uc", "name": "Shipping", "ringRole": "application" },
    { "id": "sec-controllers", "name": "Controllers", "ringRole": "adapters" },
    { "id": "sec-presenters", "name": "Presenters", "ringRole": "adapters" },
    { "id": "sec-gateways", "name": "Gateways", "ringRole": "adapters" },
    { "id": "sec-web", "name": "Web", "ringRole": "outer" },
    { "id": "sec-db", "name": "DB", "ringRole": "outer" },
    { "id": "sec-external-apis", "name": "External APIs", "ringRole": "outer" }
  ],
  "elements": [
    { "id": "el-order", "name": "Order", "sectorId": "sec-ordering-domain" },
    { "id": "el-orderline", "name": "OrderLine", "sectorId": "sec-ordering-domain" },
    { "id": "el-payment", "name": "Payment", "sectorId": "sec-payments-domain" },
    { "id": "el-shipment", "name": "Shipment", "sectorId": "sec-shipping-domain" },
    { "id": "el-place-order", "name": "PlaceOrderUseCase", "sectorId": "sec-ordering-uc" },
    { "id": "el-process-payment", "name": "ProcessPaymentUseCase", "sectorId": "sec-payments-uc" },
    { "id": "el-arrange-shipment", "name": "ArrangeShipmentUseCase", "sectorId": "sec-shipping-uc" },
    { "id": "el-order-controller", "name": "OrderController", "sectorId": "sec-controllers" },
    { "id": "el-payment-controller", "name": "PaymentController", "sectorId": "sec-controllers" },
    { "id": "el-order-presenter", "name": "OrderPresenter", "sectorId": "sec-presenters" },
    { "id": "el-payment-gateway-if", "name": "PaymentGateway", "sectorId": "sec-gateways" },
    { "id": "el-carrier-gateway-if", "name": "CarrierGateway", "sectorId": "sec-gateways" },
    { "id": "el-web-framework", "name": "ExpressApp", "sectorId": "sec-web" },
    { "id": "el-order-repo", "name": "OrderRepositoryImpl", "sectorId": "sec-db" },
    { "id": "el-payment-repo", "name": "PaymentRepositoryImpl", "sectorId": "sec-db" },
    { "id": "el-stripe-client", "name": "StripeApiClient", "sectorId": "sec-external-apis" },
    { "id": "el-carrier-client", "name": "CarrierApiClient", "sectorId": "sec-external-apis" }
  ],
  "dependencies": [
    { "id": "dep-1", "fromId": "el-order-controller", "toId": "el-place-order" },
    { "id": "dep-2", "fromId": "el-payment-controller", "toId": "el-process-payment" },
    { "id": "dep-3", "fromId": "el-order-controller", "toId": "el-order-presenter" },
    { "id": "dep-4", "fromId": "el-place-order", "toId": "el-order" },
    { "id": "dep-5", "fromId": "el-place-order", "toId": "el-process-payment" },
    { "id": "dep-6", "fromId": "el-process-payment", "toId": "el-payment" },
    { "id": "dep-7", "fromId": "el-arrange-shipment", "toId": "el-shipment" },
    { "id": "dep-8", "fromId": "el-arrange-shipment", "toId": "el-process-payment" },
    { "id": "dep-9", "fromId": "el-payment-gateway-if", "toId": "el-payment" },
    { "id": "dep-10", "fromId": "el-carrier-gateway-if", "toId": "el-shipment" },
    { "id": "dep-11", "fromId": "el-order-repo", "toId": "el-order" },
    { "id": "dep-12", "fromId": "el-payment-repo", "toId": "el-payment" },
    { "id": "dep-13", "fromId": "el-stripe-client", "toId": "el-payment-gateway-if" },
    { "id": "dep-14", "fromId": "el-carrier-client", "toId": "el-carrier-gateway-if" },
    { "id": "dep-15", "fromId": "el-web-framework", "toId": "el-order-controller" },
    { "id": "dep-16", "fromId": "el-web-framework", "toId": "el-payment-controller" }
  ],
  "actors": [
    { "id": "act-web", "name": "Web shop", "targetId": "el-web-framework" }
  ],
  "externals": [
    { "id": "ext-stripe", "name": "Stripe", "targetId": "el-stripe-client" },
    { "id": "ext-carrier", "name": "Carrier (UPS)", "targetId": "el-carrier-client" }
  ]
}
