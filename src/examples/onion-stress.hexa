{
  "app": "domainrings",
  "version": 4,
  "kind": "onion",
  "title": "Order processing — Onion (stress)",
  "rings": [
    { "role": "domain", "name": "Domain Model" },
    { "role": "domainServices", "name": "Domain Services" },
    { "role": "application", "name": "Application Services" },
    { "role": "outer", "name": "Infrastructure" }
  ],
  "elements": [
    { "id": "el-orderline", "name": "OrderLine", "ringRole": "domain" },
    { "id": "el-order", "name": "Order", "ringRole": "domain" },
    { "id": "el-payment", "name": "Payment", "ringRole": "domain" },
    { "id": "el-customer", "name": "Customer", "ringRole": "domain" },
    { "id": "el-shipment", "name": "Shipment", "ringRole": "domain" },
    { "id": "el-product", "name": "Product", "ringRole": "domain" },
    { "id": "el-pricing", "name": "PricingService", "ringRole": "domainServices" },
    { "id": "el-tax", "name": "TaxCalculator", "ringRole": "domainServices" },
    { "id": "el-discount", "name": "DiscountEngine", "ringRole": "domainServices" },
    { "id": "el-fraud", "name": "FraudDetector", "ringRole": "domainServices" },
    { "id": "el-inventory", "name": "InventoryService", "ringRole": "domainServices" },
    { "id": "el-place-order", "name": "PlaceOrderService", "ringRole": "application" },
    { "id": "el-cancel-order", "name": "CancelOrderService", "ringRole": "application" },
    { "id": "el-process-payment", "name": "ProcessPaymentService", "ringRole": "application" },
    { "id": "el-ship-order", "name": "ShipOrderService", "ringRole": "application" },
    { "id": "el-restock", "name": "RestockService", "ringRole": "application" },
    { "id": "el-event-publisher", "name": "EventPublisher", "ringRole": "outer" },
    { "id": "el-order-controller", "name": "OrderController", "ringRole": "outer" },
    { "id": "el-order-repo", "name": "OrderRepositoryImpl", "ringRole": "outer" },
    { "id": "el-payment-gateway", "name": "PaymentGatewayAdapter", "ringRole": "outer" },
    { "id": "el-payment-controller", "name": "PaymentController", "ringRole": "outer" },
    { "id": "el-shipping-adapter", "name": "ShippingAdapter", "ringRole": "outer" }
  ],
  "dependencies": [
    { "id": "dep-1", "fromId": "el-order-controller", "toId": "el-place-order" },
    { "id": "dep-2", "fromId": "el-payment-controller", "toId": "el-process-payment" },
    { "id": "dep-3", "fromId": "el-place-order", "toId": "el-pricing" },
    { "id": "dep-4", "fromId": "el-place-order", "toId": "el-inventory" },
    { "id": "dep-5", "fromId": "el-place-order", "toId": "el-order" },
    { "id": "dep-6", "fromId": "el-process-payment", "toId": "el-fraud" },
    { "id": "dep-7", "fromId": "el-process-payment", "toId": "el-payment" },
    { "id": "dep-8", "fromId": "el-cancel-order", "toId": "el-order" },
    { "id": "dep-9", "fromId": "el-ship-order", "toId": "el-shipment" },
    { "id": "dep-10", "fromId": "el-ship-order", "toId": "el-inventory" },
    { "id": "dep-11", "fromId": "el-restock", "toId": "el-inventory" },
    { "id": "dep-12", "fromId": "el-pricing", "toId": "el-discount" },
    { "id": "dep-13", "fromId": "el-pricing", "toId": "el-tax" },
    { "id": "dep-14", "fromId": "el-fraud", "toId": "el-customer" },
    { "id": "dep-15", "fromId": "el-order-repo", "toId": "el-order" },
    { "id": "dep-16", "fromId": "el-payment-gateway", "toId": "el-payment" },
    { "id": "dep-17", "fromId": "el-shipping-adapter", "toId": "el-shipment" },
    { "id": "dep-18", "fromId": "el-event-publisher", "toId": "el-order-controller" }
  ],
  "actors": [
    { "id": "act-web", "name": "Web shop", "targetId": "el-order-controller" },
    { "id": "act-admin", "name": "Ops console", "targetId": "el-payment-controller" },
    { "id": "act-mobile", "name": "Mobile app", "targetId": "el-order-controller" }
  ],
  "externals": [
    { "id": "ext-stripe", "name": "Stripe", "targetId": "el-payment-gateway" },
    { "id": "ext-carrier", "name": "Carrier API", "targetId": "el-shipping-adapter" },
    { "id": "ext-broker", "name": "Message Broker", "targetId": "el-event-publisher" }
