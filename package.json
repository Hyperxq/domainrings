    "bounded-context",
    "context-map",
    "svg",
    "visualizer",
    "react",
    "vite"
  ],
  "homepage": "https://diagrams.pbuilder.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyperxq/domainrings.git"
  },
  "bugs": {
    "url": "https://github.com/Hyperxq/domainrings/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Daniel Ramirez",
    "url": "https://github.com/Hyperxq"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
